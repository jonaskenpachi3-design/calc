# Copie para .env e preencha. Tudo marcado como OPCIONAL pode ficar vazio.

# --- obrigatórias ---
AUTH_SECRET=            # 32+ caracteres aleatórios (ex.: openssl rand -hex 32)
ADMIN_TOKEN=            # senha do operador (trocar plano, gerar links)

# --- endereço público do sistema (usado nos links dos e-mails) ---
PUBLIC_URL=https://app.seudominio.com.br

# --- e-mail (OPCIONAL): senha, confirmação e DANFSe por e-mail ---
SMTP_HOST=              # ex.: smtp.gmail.com, email-smtp.sa-east-1.amazonaws.com
SMTP_PORT=              # 587 (STARTTLS) ou 465 com SMTP_SECURE=true
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nexo Fiscal <contato@seudominio.com.br>
APP_NAME=Nexo Fiscal
EXIGIR_CONFIRMACAO_EMAIL=false   # true = só usa o sistema depois de confirmar o e-mail

# --- cobrança com Asaas (OPCIONAL) ---
ASAAS_API_KEY=          # comece pelo SANDBOX ($aact_hmlg_...); produção só depois de testar
ASAAS_WEBHOOK_TOKEN=    # 32+ caracteres; o MESMO token cadastrado no webhook do Asaas
PRECO_PROFISSIONAL=149
PRECO_ILIMITADO=399
CARENCIA_DIAS=5

# --- alíquotas nominais (%) exigidas pela calculadora a partir de 2027: CONFIRME ---
ALIQUOTA_CBS=
ALIQUOTA_IBS_ESTADUAL=
ALIQUOTA_IBS_MUNICIPAL=
